# 项目专属工具链与依赖缓存
/.toolchain/
/.venv

# ROS2 colcon 构建产物
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# Android 本地配置和构建产物
/android/**/.gradle/
/android/**/build/
/android/**/local.properties

# 官方 SDK 通过独立 Git 仓库及固定标签获取
/third_party/robotemi-sdk/

# 官方公开视觉测试资产仅供本地运行，不作为项目发布素材
/assets/vision/*.onnx
/assets/vision/*.part
/assets/vision/*.avi

# 阶段2.8高频原始运行日志；源码、配置、摘要及哈希索引仍纳入版本管理。
/artifacts/phase2_8/raw/
/artifacts/phase2_8/archive/

/artifacts/phase2_8/replays/

# 阶段2.9高频游客状态原始流保留在本机；可验证的gzip归档、摘要和哈希清单进入版本管理。
/docs/phase2_9/experiments/**/system/visitor_team.jsonl
/docs/phase2_9/experiments/**/system/*.pid

# pytest生成的Mock系统运行目录不是实验验收证据。
/docs/runs/mock-system-*/
